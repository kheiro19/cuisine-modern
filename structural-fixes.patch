+    buildFasteners(geo, cab, { carcaseTh: 18, frontTh: 18 }).filter((x) => x.kind === 'HINGE_ARM').forEach((a) => assert.ok(a.sizeMm[0] <= 40, `hinge arm of ${a.sizeMm[0]} mm`));
