{
  "name": "cuisine-modern-flatma",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "textures": "node scripts/build-texture-manifest.mjs",
    "models": "node scripts/build-model-manifest.mjs",
    "models:check": "tsx scripts/check-models.ts",
    "predev": "npm run textures && npm run models",
    "dev": "vite",
    "prebuild": "npm run textures && npm run models",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts tests/product/*.test.ts tests/compat/*.test.ts",
    "test:product": "tsx --test tests/product/*.test.ts",
    "test:compat": "tsx --test tests/compat/*.test.ts",
    "test:ui": "vitest run",
    "test:all": "npm test && npm run test:ui",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json && tsc -p tsconfig.ui.json"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.0",
    "@react-three/fiber": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.163.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  }
}
